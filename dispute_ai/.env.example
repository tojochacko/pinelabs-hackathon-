# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "ollama" for local dev, "bedrock" for production
LLM_PROVIDER=ollama

# ── Ollama (local dev) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3

# ── Amazon Bedrock (production — leave blank for local dev) ───────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Pine Labs ─────────────────────────────────────────────────────────────────
PINE_LABS_BASE_URL=https://api.pinelabs.com
PINE_LABS_CLIENT_ID=
PINE_LABS_CLIENT_SECRET=
PINE_LABS_WEBHOOK_SECRET=your-hmac-secret
PINE_LABS_MOCK=true

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

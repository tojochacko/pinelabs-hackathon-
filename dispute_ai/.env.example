# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "ollama" for local dev, "bedrock" for production
LLM_PROVIDER=ollama

# ── Ollama (local dev) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3

# ── Amazon Bedrock (production — set LLM_PROVIDER=bedrock to activate) ───────
# Use a Bedrock API key (Bearer token) — no AWS IAM credentials needed.
# Generate one in AWS Console → Amazon Bedrock → API keys.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Model ID or inference profile ARN:
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Pine Labs ─────────────────────────────────────────────────────────────────
PINE_LABS_BASE_URL=https://api.pinelabs.com
PINE_LABS_CLIENT_ID=
PINE_LABS_CLIENT_SECRET=
PINE_LABS_WEBHOOK_SECRET=your-hmac-secret
PINE_LABS_MOCK=true

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── WhatsApp (CallMeBot — free forever) ───────────────────────────────────────
# Each merchant must activate by adding +34 644 60 20 96 on WhatsApp
# and sending the message: "I allow callmebot to send me messages"
# They will receive their personal API key via WhatsApp.
# Pass the key as merchant_whatsapp_key in the dispute payload,
# or set CALLMEBOT_API_KEY as a fallback for single-merchant setups.
CALLMEBOT_API_KEY=
